generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ConnectionStatus {
  connected
  expired
  disconnected
}

enum ContentType {
  image
  carousel
  reel
  video
}

enum ContentStatus {
  draft
  awaiting_approval
  approved
  scheduled
  publishing
  published
  failed
  cancelled
}

enum ScheduledPostStatus {
  scheduled
  publishing
  published
  failed
  cancelled
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brandProfile BrandProfile?
  instagramAccounts InstagramAccount[]
  contents Content[]
  recommendations AIRecommendation[]
  usages Usage[]
  automationSettings AutomationSettings?
  auditLogs AuditLog[]
}

model BrandProfile {
  id String @id @default(cuid())
  userId String @unique
  name String?
  niche String?
  brandVoice String?
  language String?
  audience String?
  goals Json?
  contentPillars Json?
  postingFrequency Int?
  postingTimes Json?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InstagramAccount {
  id String @id @default(cuid())
  userId String
  igUserId String
  username String?
  accessTokenEncrypted String?
  tokenExpiresAt DateTime?
  profileImageUrl String?
  connectionStatus ConnectionStatus @default(connected)
  lastSyncAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  contents Content[]
  scheduledPosts ScheduledPost[]

  @@unique([userId, igUserId])
}

model Content {
  id String @id @default(cuid())
  userId String
  instagramAccountId String?
  topic String?
  hook String?
  title String?
  caption String?
  hashtags String[]
  mediaUrls String[]
  type ContentType @default(image)
  status ContentStatus @default(draft)
  aiGenerated Boolean @default(false)
  qualityScore Float?
  scheduledAt DateTime?
  publishedAt DateTime?
  externalPostId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)
  scheduledPost ScheduledPost?
}

model ScheduledPost {
  id String @id @default(cuid())
  contentId String @unique
  instagramAccountId String
  scheduledAt DateTime
  jobId String @unique
  status ScheduledPostStatus @default(scheduled)
  attemptCount Int @default(0)
  errorMessage String?
  publishedAt DateTime?
  externalPostId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
}

model AIRecommendation {
  id String @id @default(cuid())
  userId String
  title String
  description String?
  type String?
  score Float?
  data Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Usage {
  id String @id @default(cuid())
  userId String
  month String
  generations Int @default(0)
  publishedPosts Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

model AutomationSettings {
  id String @id @default(cuid())
  userId String @unique
  enabled Boolean @default(false)
  mode String @default("manual")
  postsPerWeek Int @default(3)
  autoApproveEducational Boolean @default(false)
  autoApprovePromotional Boolean @default(false)
  requireApprovalSensitive Boolean @default(true)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id String @id @default(cuid())
  userId String
  action String
  status String?
  details Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
