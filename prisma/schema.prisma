generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ConnectionStatus {
  connected
  expired
  disconnected
}

enum ContentType {
  image
  carousel
  reel
  video
}

enum ContentStatus {
  draft
  awaiting_approval
  approved
  scheduled
  publishing
  published
  failed
  cancelled
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brandProfile BrandProfile?
  instagramAccounts InstagramAccount[]
  contents Content[]
  recommendations AIRecommendation[]
  usages Usage[]
  automationSettings AutomationSettings?
  auditLogs AuditLog[]
}

model BrandProfile {
  id String @id @default(cuid())
  userId String @unique
  brandName String?
  niche String?
  audience String?
  voice String?
  goals Json?
  contentPillars Json?
  postingFrequency Int?
  postingTimes Json?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InstagramAccount {
  id String @id @default(cuid())
  userId String
  instagramUserId String @unique
  username String?
  accessToken String?
  profileImageUrl String?
  connectionStatus ConnectionStatus @default(connected)
  lastSyncAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  contents Content[]
}

model Content {
  id String @id @default(cuid())
  userId String
  instagramAccountId String?
  title String?
  caption String?
  mediaUrl String?
  type ContentType @default(image)
  status ContentStatus @default(draft)
  aiGenerated Boolean @default(false)
  scheduledAt DateTime?
  publishedAt DateTime?
  externalPostId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)
}

model AIRecommendation {
  id String @id @default(cuid())
  userId String
  title String
  description String?
  type String?
  score Float?
  data Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Usage {
  id String @id @default(cuid())
  userId String
  month String
  generations Int @default(0)
  publishedPosts Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

model AutomationSettings {
  id String @id @default(cuid())
  userId String @unique
  mode String @default("manual")
  autopilotEnabled Boolean @default(false)
  autoPublish Boolean @default(false)
  approvalRequired Boolean @default(true)
  postingFrequency Int @default(3)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id String @id @default(cuid())
  userId String
  action String
  details Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}